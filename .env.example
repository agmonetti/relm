# Optional environment variables for relm.
#
# relm itself is configured from the command line (DSN) and the connection
# screen; it reads no environment variables at runtime.
#
# This file documents the variables used by the test suite and the demo
# seeder. Values below match the repo's compose.yaml. Note that Go does not
# load .env files automatically: export the values yourself, e.g.
#
#   docker compose up -d --wait
#   set -a; source .env; set +a        # or set each var inline, as in README
#   go test -timeout 300s ./internal/store/...
#
# All variables are OPTIONAL: tests are skipped when the *_HOST var is unset,
# and the demo seeder falls back to these same defaults.

# --- Integration tests (network engines; need `docker compose up -d` first) ---

RELM_TEST_POSTGRES_HOST=localhost
RELM_TEST_POSTGRES_USER=postgres
RELM_TEST_POSTGRES_PASSWORD=postgres
RELM_TEST_POSTGRES_DATABASE=test

RELM_TEST_MYSQL_HOST=localhost
RELM_TEST_MYSQL_USER=root
RELM_TEST_MYSQL_PASSWORD=root
RELM_TEST_MYSQL_DATABASE=test

RELM_TEST_MARIADB_HOST=localhost
RELM_TEST_MARIADB_USER=root
RELM_TEST_MARIADB_PASSWORD=root
RELM_TEST_MARIADB_DATABASE=test

RELM_TEST_MSSQL_HOST=localhost
RELM_TEST_MSSQL_USER=sa
RELM_TEST_MSSQL_PASSWORD=Str0ng!Passw0rd
RELM_TEST_MSSQL_DATABASE=master

# --- Demo seeder (`go run ./cmd/demo --all`); overrides the defaults above ---
# Any of POSTGRES_HOST/POSTGRES_PORT/POSTGRES_USER/POSTGRES_PASSWORD/
# POSTGRES_DATABASE (and the parallel MYSQL_/MARIADB_/MSSQL_ variants), plus
# DEMO_SQLITE_PATH for the demo.db path.

# --- User configuration ---
# Overrides the config directory used for history.json, connections.json and
# prefs.json (default: ~/.config/relm).
# RELM_CONFIG_DIR=/path/to/config